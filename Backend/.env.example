NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb://mongodb:27017/deplens
FRONTEND_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-this-access-secret-must-be-at-least-32-chars
JWT_REFRESH_SECRET=change-this-refresh-secret-must-be-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
